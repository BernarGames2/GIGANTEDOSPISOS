# Copie para .env.local (desenvolvimento) ou configure no painel da Vercel/Netlify.

# URL pública definitiva (usada em metadados, sitemap e JSON-LD).
NEXT_PUBLIC_SITE_URL=https://gigantedospisos.com.br

# Opcional — integração com o Google (Places API "New") para nota, total e
# avaliações reais. Sem estas variáveis o site usa os dados fixos + placeholders.
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=
